# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.directory
*~
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python
__pycache__/
*.pyc

# OS
*.tmp

# Raw downloaded assets (organized copies are in assets/)
assets-downloaded/

# IDE / agent tools
.codegraph/
.reasonix/

# Build output
builds/

# Project-local portable tools (not game assets)
.tools/

# Local agent workspace
.workbuddy/

# Website-only Godot import sidecars (site/.gdignore prevents regeneration)
/site/**/*.import

# Screenshot debris
/gem_shot.png.import
/gem_crop_*.png.import
/run_log.txt
/run_err.txt

# 本轮取证产物（工作文件，不进仓库；重跑 tools/icon_evidence_shots.gd 可再生）
/tools/evidence/
/tools/audit_icons_report.json

# Local audio production outputs (final game OGG and recipes are tracked)
/artifacts/music-audition-*/
/artifacts/game-audio-*/raw/
/artifacts/game-audio-*/preview/
/artifacts/game-audio-*/history/
/artifacts/game-audio-*/receipts/
/artifacts/game-audio-*/*.zip
/artifacts/game-audio-*/gameplay_mix.mp3
/artifacts/game-audio-*/gameplay_mix.wav
/artifacts/game-audio-*/listening_bgm*.json
/artifacts/game-audio-*/listening_loops*.json
/artifacts/game-audio-*/listening_sfx*.json

# 本轮迭代资产制作：原图与审阅拼版是本地工作文件（52MB），
# 进仓库的是计划 JSON、工作流副本与台账；原图另外留在 E:\AI\ComfyUI\output\vhr_iter\
/artifacts/iteration_assets/*.png
/artifacts/comfy_gen/

# Local Boss source renders and reproducible preview outputs
/artifacts/blood_lord/
/artifacts/blood_matriarch/
/artifacts/tomb_warden/
/artifacts/alchemist_prince/
/artifacts/eclipse_queen/
