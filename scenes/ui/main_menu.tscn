[gd_scene load_steps=4 format=3 uid="uid://main_menu"]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_script"]
[ext_resource type="PackedScene" uid="uid://upgrade_shop" path="res://scenes/ui/upgrade_shop.tscn" id="2_shop"]
[ext_resource type="PackedScene" uid="uid://character_select" path="res://scenes/ui/character_select.tscn" id="3_charsel"]

[node name="MainMenu" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.02, 0.08, 1.0)

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleRow" type="HBoxContainer" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="BatLeft" type="TextureRect" parent="CenterContainer/VBoxContainer/TitleRow"]
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="TitleLabel" type="Label" parent="CenterContainer/VBoxContainer/TitleRow"]
layout_mode = 2
text = "吸血鬼猎人"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 48
theme_override_colors/font_color = Color(0.86, 0.16, 0.22, 1.0)
theme_override_colors/font_outline_color = Color(0.05, 0.02, 0.03, 1.0)
theme_override_constants/outline_size = 8

[node name="BatRight" type="TextureRect" parent="CenterContainer/VBoxContainer/TitleRow"]
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="SubtitleLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
text = "Vampire Hunter Roguelite"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.6, 0.4, 0.5, 1.0)

[node name="CrystalsRow" type="HBoxContainer" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 1

[node name="CrystalIcon" type="TextureRect" parent="CenterContainer/VBoxContainer/CrystalsRow"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="CrystalsLabel" type="Label" parent="CenterContainer/VBoxContainer/CrystalsRow"]
layout_mode = 2
text = "血晶: 0"
